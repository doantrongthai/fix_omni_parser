{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Step3_YoloIconDetections",
  "description": "Intermediate schema of icon/button bounding boxes detected by YOLOv8/v9",
  "type": "object",
  "required": [
    "model_version",
    "box_threshold",
    "detections"
  ],
  "properties": {
    "model_version": {
      "type": "string"
    },
    "box_threshold": {
      "type": "number"
    },
    "total_detected": {
      "type": "integer"
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bbox_normalized",
          "confidence",
          "class_id",
          "label"
        ],
        "properties": {
          "bbox_normalized": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[xmin, ymin, xmax, ymax] normalized to [0, 1]"
          },
          "confidence": {
            "type": "number"
          },
          "class_id": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}