{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Step4_OcrExtractionResults",
  "description": "Intermediate schema of text regions extracted by EasyOCR / PaddleOCR",
  "type": "object",
  "required": [
    "engine",
    "text_threshold",
    "extracted_texts"
  ],
  "properties": {
    "engine": {
      "type": "string",
      "enum": [
        "easyocr",
        "paddleocr"
      ]
    },
    "text_threshold": {
      "type": "number"
    },
    "extracted_texts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "bbox_normalized",
          "confidence"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "bbox_normalized": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[xmin, ymin, xmax, ymax] normalized to [0, 1]"
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    }
  }
}