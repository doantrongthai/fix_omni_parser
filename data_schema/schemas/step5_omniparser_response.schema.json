{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Step5_OmniParserResponse",
  "description": "Schema for HTTP POST /parse/ response from OmniParser server",
  "type": "object",
  "required": [
    "som_image_base64",
    "parsed_content_list",
    "latency"
  ],
  "properties": {
    "som_image_base64": {
      "type": "string",
      "description": "Base64 encoded Set-of-Mark annotated PNG image with labeled boxes and ID tags"
    },
    "parsed_content_list": {
      "type": "array",
      "description": "Ordered list of detected screen UI elements corresponding to Box IDs",
      "items": {
        "type": "object",
        "required": [
          "type",
          "bbox",
          "interactivity",
          "content"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "icon"
            ]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[ymin, xmin, ymax, xmax] normalized coordinates [0, 1]"
          },
          "interactivity": {
            "type": "boolean"
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "latency": {
      "type": "number",
      "description": "Processing time in seconds"
    }
  }
}